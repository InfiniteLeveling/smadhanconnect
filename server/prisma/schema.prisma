datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  STUDENT
  INDUSTRY
  EXPERT
  ADMIN
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChallengeStatus {
  SUBMITTED
  AI_ANALYZED
  MATCHED
  TEAM_FORMED
  RESEARCH
  PROTOTYPE
  INDUSTRY_REVIEW
  FIELD_PILOT
  IMPLEMENTED
  CLOSED
}

enum MatchStatus {
  RECOMMENDED
  VIEWED
  INTERESTED
  ACCEPTED
  REJECTED
}

enum TeamRole {
  TEAM_LEAD
  AI_ML
  BACKEND
  FRONTEND
  IOT
  RESEARCH
  DESIGN
  DOMAIN_EXPERT
  OTHER
}

enum ProjectStatus {
  RESEARCH
  PLANNING
  DEVELOPMENT
  PROTOTYPE
  REVIEW
  PILOT
  IMPLEMENTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CropListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

enum LandListingType {
  SALE
  LEASE
  DISCOVERY
}

enum MentorRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum SubscriptionPlan {
  FARMER_FREE
  FARMER_PRO
  STUDENT_FREE
  STUDENT_PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  CHALLENGE_MATCH
  TEAM_INVITATION
  MENTOR_REQUEST
  MENTOR_RESPONSE
  PROJECT_UPDATE
  MARKETPLACE_UPDATE
  SYSTEM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  name         String
  role         Role      @default(FARMER)
  profileImage String?
  state        String?
  district     String?
  village      String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  farmerProfile   FarmerProfile?
  studentProfile  StudentProfile?
  industryProfile IndustryProfile?
  mentorProfile   MentorProfile?
  
  notifications    Notification[]
  subscriptions    Subscription[]
  aiUsageLogs      AIUsageLog[]
  teamMemberships  TeamMember[]
  createdTeams     Team[]
  assignedTasks    Task[]
  buyerTx          Transaction[]  @relation("BuyerTransactions")
  sellerTx         Transaction[]  @relation("SellerTransactions")

  @@index([email])
  @@index([role])
}

model FarmerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmType           String?
  crops              String[]
  landArea           Float?
  experienceYears    Int?
  irrigationType     String?
  soilType           String?
  bio                String?
  location           String?
  verificationStatus String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  challenges   Challenge[]
  cropListings CropListing[]
  landListings LandListing[]
}

model StudentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college      String?
  course       String?
  year         Int?
  skills       String[]
  technologies String[]
  interests    String[]
  experience   String?
  portfolioUrl String?
  githubUrl    String?
  linkedinUrl  String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches ChallengeMatch[]
}

model IndustryProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  industry           String
  expertise          String[]
  description        String?
  website            String?
  location           String?
  verificationStatus String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sponsoredChallenges SponsoredChallenge[]
  projectReviews      ProjectReview[]
}

model MentorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise    String[]
  skills       String[]
  experience   Int?
  industry     String?
  availability String?  @default("AVAILABLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mentorRequests MentorRequest[]
}

model Challenge {
  id              String          @id @default(uuid())
  farmerId        String
  farmer          FarmerProfile   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String
  cropType        String?
  location        String
  urgency         Urgency         @default(MEDIUM)
  expectedOutcome String?
  status          ChallengeStatus @default(SUBMITTED)
  images          String[]
  videos          String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  aiAnalysis          ChallengeAIAnalysis?
  matches             ChallengeMatch[]
  project             Project?
  sponsoredChallenges SponsoredChallenge[]

  @@index([status])
  @@index([category])
  @@index([farmerId])
}

model ChallengeAIAnalysis {
  id            String    @id @default(uuid())
  challengeId   String    @unique
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  domain        String
  skills        String[]
  technologies  String[]
  difficulty    String
  solutionAreas String[]
  summary       String
  createdAt     DateTime  @default(now())
}

model ChallengeMatch {
  id            String         @id @default(uuid())
  challengeId   String
  challenge     Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score         Float
  matchedSkills String[]
  reason        String
  status        MatchStatus    @default(RECOMMENDED)
  createdAt     DateTime       @default(now())

  @@unique([challengeId, studentId])
  @@index([studentId])
}

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdBy   String
  creator     User         @relation(fields: [createdBy], references: [id])
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now())

  members TeamMember[]
  project Project?
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(RESEARCH)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Project {
  id            String        @id @default(uuid())
  challengeId   String        @unique
  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  teamId        String        @unique
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title         String
  description   String
  status        ProjectStatus @default(RESEARCH)
  repositoryUrl String?
  demoUrl       String?
  startDate     DateTime      @default(now())
  targetDate    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tasks          Task[]
  milestones     Milestone[]
  projectFiles   ProjectFile[]
  projectUpdates ProjectUpdate[]
  mentorRequests MentorRequest[]
  projectReviews ProjectReview[]
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String?
  assignee    User?        @relation(fields: [assignedTo], references: [id])
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  phaseNumber Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
}

model MentorRequest {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        MentorProfile       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  message       String
  status        MentorRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ProjectReview {
  id         String          @id @default(uuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  industryId String
  industry   IndustryProfile @relation(fields: [industryId], references: [id], onDelete: Cascade)
  rating     Int             @default(5)
  feedback   String
  createdAt  DateTime        @default(now())
}

model SponsoredChallenge {
  id          String          @id @default(uuid())
  challengeId String
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  industryId  String
  industry    IndustryProfile @relation(fields: [industryId], references: [id], onDelete: Cascade)
  amount      Float
  status      String          @default("PLEDGED")
  createdAt   DateTime        @default(now())
}

model CropListing {
  id                 String            @id @default(uuid())
  farmerId           String
  farmer             FarmerProfile     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName           String
  category           String
  quantity           Float
  unit               String            @default("KG")
  expectedPrice      Float
  location           String
  harvestDate        DateTime?
  description        String?
  images             String[]
  verificationStatus String            @default("UNVERIFIED")
  status             CropListingStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  transactions Transaction[]
}

model LandListing {
  id                 String          @id @default(uuid())
  farmerId           String
  farmer             FarmerProfile   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  listingType        LandListingType @default(DISCOVERY)
  location           String
  area               Float
  landType           String?
  soilType           String?
  irrigation         String?
  price              Float
  description        String?
  images             String[]
  verificationStatus String          @default("UNVERIFIED")
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  transactions Transaction[]
}

model Transaction {
  id               String       @id @default(uuid())
  cropListingId    String?
  cropListing      CropListing? @relation(fields: [cropListingId], references: [id])
  landListingId    String?
  landListing      LandListing? @relation(fields: [landListingId], references: [id])
  buyerId          String
  buyer            User         @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId         String
  seller           User         @relation("SellerTransactions", fields: [sellerId], references: [id])
  amount           Float
  commissionRate   Float        @default(0.02)
  commissionAmount Float
  status           String       @default("PENDING")
  createdAt        DateTime     @default(now())
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FARMER_FREE)
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  provider             String?            @default("SYSTEM")
  providerSubId        String?
  createdAt            DateTime           @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  type      NotificationType @default(SYSTEM)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

model ImpactMetric {
  id                   String   @id @default(uuid())
  farmersHelped        Int      @default(0)
  problemsSubmitted    Int      @default(0)
  problemsSolved       Int      @default(0)
  studentsInvolved     Int      @default(0)
  industryPartners     Int      @default(0)
  solutionsDeveloped   Int      @default(0)
  solutionsPiloted     Int      @default(0)
  solutionsImplemented Int      @default(0)
  isDemo               Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model AIUsageLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  endpoint   String
  provider   String
  model      String
  tokensUsed Int?     @default(0)
  status     String   @default("SUCCESS")
  createdAt  DateTime @default(now())
}
