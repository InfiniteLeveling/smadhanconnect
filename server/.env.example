# Server Environment Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invictus_db?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=invictus_super_secret_jwt_access_key_2026_sih
JWT_REFRESH_SECRET=invictus_super_secret_jwt_refresh_key_2026_sih
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / Queue URL
REDIS_URL=redis://localhost:6379

# AI Service Configuration
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# Storage Configuration
STORAGE_PROVIDER=mock
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=invictus-uploads

# Email Provider
EMAIL_PROVIDER=mock
EMAIL_API_KEY=your_email_api_key
